@{
    Layout = "_SimpleLayout";
}


@{

var arr = new string [] {"Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company"};

}

@foreach (var product in arr)
{
    <div>
        <h2>Product: @product</h2>
    </div>
}

@if (arr.Length > 0)
{
    <p>Total suppliers: @arr.Length</p>
}

else
{
    <p>No suppliers available.</p>
}

@if(arr.Length>3)
{
    <p>We have enough suppliers</p>
}

else
{
    <p>We need more suppliers</p>
}


<div>
    <h1>Suppliers</h1>
    <p>Welcome to the Suppliers page!</p>
</div>