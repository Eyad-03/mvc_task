<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Cafeteria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Cafeteria")">
                    University Cafeteria
                </a>
                <ul class="navbar-nav flex-wrap">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Cafeteria")">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Products", "Supply")">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Suppliers", "Supply")">Suppliers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("MyRequests", "SupplyRequest")">My Requests</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "SupplyRequest")">About</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top text-muted text-center py-3">
        &copy; 2026 - University Cafeteria Supply Management System
    </footer>
@RenderSection("Scripts", required: false)
</body>
</html>