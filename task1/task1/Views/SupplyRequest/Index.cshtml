@model task1.Models.SupplyItem
@{
    ViewData["Title"] = "Create Supply Request";
    var draftItems = (List<task1.Models.SupplyItem>)ViewBag.DraftItems;
    var priorities = (string[])ViewBag.Priorities;
    var categories = (string[])ViewBag.Categories;
    string preferred = ViewBag.PreferredPriority;
    bool hasPreference = ViewBag.HasPreferenceCookie;
}

<h2 class="mb-4">Create Supply Request</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (hasPreference)
{
    <div class="alert alert-info">Your preferred request priority is <strong>@preferred</strong>.</div>
}

<div class="row g-4">
    <!-- Add product form -->
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Add Product</h5>
            </div>
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger"></div>

                <form method="post" action="@Url.Action("AddItem", "SupplyRequest")">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="ProductName" class="form-label">Product Name</label>
                        <input type="text" id="ProductName" name="ProductName" value="@Model.ProductName"
                               class="form-control" placeholder="e.g. Coffee" required />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label for="Category" class="form-label">Category</label>
                        <select id="Category" name="Category" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c" selected="@(Model.Category == c)">@c</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Quantity" class="form-label">Quantity</label>
                            <input type="number" id="Quantity" name="Quantity" min="1" step="1"
                                   value="@(Model.Quantity > 0 ? Model.Quantity.ToString() : "")"
                                   class="form-control" required />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="UnitPrice" class="form-label">Unit Price (JD)</label>
                            <input type="number" id="UnitPrice" name="UnitPrice" min="0.01" step="0.01"
                                   value="@(Model.UnitPrice > 0 ? Model.UnitPrice.ToString() : "")"
                                   class="form-control" required />
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Priority" class="form-label">Priority</label>
                        <select id="Priority" name="Priority" class="form-select">
                            @foreach (var p in priorities)
                            {
                                <option value="@p" selected="@(Model.Priority == p)">@p</option>
                            }
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success">Add Product</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Preferred priority (Cookie) -->
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Default Request Priority</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("SavePreference", "SupplyRequest")">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="preferredPriority" class="form-label">Preferred Priority</label>
                        <select id="preferredPriority" name="preferredPriority" class="form-select">
                            @foreach (var p in priorities)
                            {
                                <option value="@p" selected="@(preferred == p)">@p</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary">Save Preference</button>
                </form>
                <p class="text-muted small mt-2 mb-0">Your preference is remembered for 7 days.</p>
            </div>
        </div>
    </div>
</div>

<!-- Current draft (Session) -->
<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Current Draft Request (@draftItems.Count product(s))</h5>
    </div>
    <div class="card-body">
        @if (draftItems.Count == 0)
        {
            <p class="text-muted mb-0">No products have been added yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Priority</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < draftItems.Count; i++)
                        {
                            var item = draftItems[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.ProductName</td>
                                <td>@item.Category</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("0.00") JD</td>
                                <td>@item.Priority</td>
                                <td>@item.TotalCost.ToString("0.00") JD</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2">
                <a href="@Url.Action("Review", "SupplyRequest")" class="btn btn-primary">Review Request</a>
                <form method="post" action="@Url.Action("ClearDraft", "SupplyRequest")">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Clear Draft</button>
                </form>
            </div>
        }
    </div>
</div>
