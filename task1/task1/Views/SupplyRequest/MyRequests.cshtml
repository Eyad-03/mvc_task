@model List<task1.Models.SupplyRequest>
@{
    ViewData["Title"] = "My Requests";
}

<h2 class="mb-4">My Supply Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">There are no confirmed supply requests yet.</div>
    <a href="@Url.Action("Index", "SupplyRequest")" class="btn btn-primary">Create Supply Request</a>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Request ID</th>
                    <th>Number of Products</th>
                    <th>Subtotal</th>
                    <th>Preparation Fee</th>
                    <th>Discount</th>
                    <th>Final Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>#@(r.RequestId)</td>
                        <td>@r.NumberOfProducts</td>
                        <td>@r.Subtotal.ToString("0.00") JD</td>
                        <td>@r.PreparationFee.ToString("0.00") JD (@r.Priority)</td>
                        <td>@r.Discount.ToString("0.00") JD</td>
                        <td><strong>@r.FinalTotal.ToString("0.00") JD</strong></td>
                        <td><span class="badge bg-success">@r.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
