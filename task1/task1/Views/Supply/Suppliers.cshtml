<div class="container my-4">
    <h2 class="mb-1">@ViewData["Title"]</h2>
    <p class="text-muted mb-4">Count: @ViewData["count"]</p>

    <div class="row g-3">
        @foreach (var item in ViewBag.Suppliers)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <p class="card-text mb-0">@item</p>
                    </div>
                </div>
            </div>
        }
        <h1></h1>
    </div>
</div>
