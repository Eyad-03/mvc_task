<div class="container my-4">
    <div class="row g-3">
        @foreach (var item in ViewBag.Category)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <p class="card-text mb-0">@item</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
