@model List<Supplier>

<h1>Suppliers</h1>

<a href="@Url.Action("Create", "Supplier")">Create New Supplier</a>

<table>

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Id</td>
                <td>@supplier.Name</td>
                <td>@supplier.Phone</td>
                <td>@supplier.Email</td>
            </tr>
        }
    </tbody>

</table>