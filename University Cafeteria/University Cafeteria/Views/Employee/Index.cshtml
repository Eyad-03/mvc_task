@model List<Employee>

<div class="d-flex justify-content-between align-items-center my-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a class="btn btn-success" asp-action="Create">+ Create New Employee</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Position</th>
                <th class="text-end">Salary</th>
                <th>Hire Date</th>
                <th class="text-center">Orders Count</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No employees found.</td>
                </tr>
            }
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td class="fw-semibold">@employee.FullName</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Email</td>
                    <td>@employee.Position</td>
                    <td class="text-end">@employee.Salary.ToString("0.00")</td>
                    <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-center"><span class="badge bg-secondary">@employee.Orders.Count</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@employee.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@employee.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
