@model List<Order>

<div class="d-flex justify-content-between align-items-center my-3">
    <h1 class="h3 mb-0">Orders</h1>
    <a class="btn btn-success" asp-action="Create">+ Create New Order</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Customer Name</th>
                <th>Order Date</th>
                <th class="text-end">Total Price</th>
                <th>Status</th>
                <th>Employee</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No orders found.</td>
                </tr>
            }
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td class="fw-semibold">@order.CustomerName</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end">@order.TotalPrice.ToString("0.00")</td>
                    <td>@order.Status</td>
                    <td>@order.Employee?.FullName</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@order.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@order.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@order.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
